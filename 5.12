With({d: ParseJSON(Topic.DraftOut.text)}, If(Topic.Status = "ready" && Not(Topic.PlanOK), "I couldn't build that draft cleanly. Could you say the change again, maybe a little differently?", Text(d.message.intro) & If(Topic.Status = "ready" && Not(IsBlank(Topic.ChangesShown)), Char(10) & Char(10) & Topic.ChangesShown, "") & If(Topic.Status = "ready" && CountRows(Table(d.unchanged)) > 0, Char(10) & Char(10) & "No change needed: " & Concat(Table(d.unchanged), Text(ThisRecord.Value.section), ", "), "") & If(CountRows(Table(d.message.notes)) > 0, Char(10) & Char(10) & Concat(Table(d.message.notes), "- " & Text(ThisRecord.Value.note), Char(10)), "") & Char(10) & Char(10) & Text(d.message.ask)))
