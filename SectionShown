With({lines: Filter(ForAll(Split(Substitute(Substitute(Substitute(Text(Global.OriginalJD.PrincipalDuties), "<br />", Char(10)), "<br/>", Char(10)), "<br>", Char(10)), Char(10)), With({t: Trim(Substitute(ThisRecord.Value, "**", ""))}, If(Left(t, 1) in ["•", "-", "*", "·"], Trim(Mid(t, 2)), t))), !IsBlank(Value))}, Concat(ForAll(Sequence(CountRows(lines)) As n, n.Value & ". " & Index(lines, n.Value).Value), Value, Char(10)))
